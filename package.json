{
  "name": "dsh-memento",
  "description": "Bounded, layered, approval-gated, auditable cross-session memory for DeepSeek Harness — a capability seam (ctx.memory service + local SQLite provider + memory tool + frozen snapshot injection), not another memory warehouse",
  "version": "0.3.1",
  "type": "module",
  "main": "./index.mjs",
  "types": "./types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./index.mjs"
    },
    "./client": {
      "types": "./client/client.d.ts",
      "default": "./client/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "types.d.ts",
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.es.md",
    "README.pt.md",
    "README.hi.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-memento.git"
  },
  "homepage": "https://github.com/PerryLink/dsh-memento#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-memento/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "package.json"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "harness:tool",
      "filesystem:read",
      "filesystem:write",
      "network:none",
      "subprocess:none",
      "shell:none",
      "python:none",
      "credentials:none"
    ],
    "compatibility": {
      "dshVersions": ["0.1.0-rc.6"]
    },
    "capability": {
      "id": "memory",
      "kind": "tool",
      "invocation": "memory action=query text=preferences",
      "expected": "structured result listing entries matching the query in the local memory store"
    },
    "evidence": {
      "install": "docs/OMDSH_REVIEW.md",
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.0.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "coverage": "node --test --experimental-test-coverage \"test/*.test.mjs\"",
    "check:coverage": "node scripts/check-coverage.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "check:readmes": "node scripts/verify-readmes.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "approval",
    "audit",
    "sqlite",
    "cordis",
    "llm"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
