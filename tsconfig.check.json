      "@deepseek-ai/schemastery": ["D:/deepseek-harness/vendor/schemastery/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session": ["D:/deepseek-harness/packages/core/session/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session/*": ["D:/deepseek-harness/packages/core/session/lib/types/*"],
      "@deepseek-ai/dsh-tools": ["D:/deepseek-harness/packages/core/tools/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-settings": ["D:/deepseek-harness/packages/settings/settings/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-llm": ["D:/deepseek-harness/packages/llm/llm/lib/types/index.d.ts"],
