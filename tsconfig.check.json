      "@deepseek-ai/dsh-system-prompt": ["D:/deepseek-harness/packages/core/system-prompt/lib/types/index.d.ts"]
    }
  },
  "include": ["index.mjs", "lib/**/*.mjs", "scripts/**/*.mjs", "bin/**/*.mjs", "types.d.ts"]
}
