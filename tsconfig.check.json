      "@deepseek-ai/dsh-agent": ["D:/deepseek-harness/packages/core/agent/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-util-values": ["D:/deepseek-harness/packages/util/values/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-brand": ["D:/deepseek-harness/packages/util/brand/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-invariants": ["D:/deepseek-harness/packages/runtime-diagnostics/invariants/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-user-approval": ["D:/deepseek-harness/packages/interaction/user-approval/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session-projection": ["D:/deepseek-harness/packages/session/session-projection/lib/types/index.d.ts"],
